# Custom integrations for this fork (not part of upstream Logto).
# Copy to .env and fill in. None are required unless the feature is enabled.

# Cloudflare Turnstile — landing demo chat bot protection
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# OpenAI — landing demo chat model
OPENAI_API_KEY=
OPENAI_API_PROXY_ENDPOINT=
OPENAI_MODEL_NAME=
LANDING_CHAT_MODEL_ENABLED=

# Landing page — lead capture and demo requests
LANDING_UPSTREAM=
LANDING_LEAD_BOOKING_URL=
LANDING_LEAD_LEADS_URL=
LANDING_LEAD_FILES_BASE=
LANDING_LEAD_LINK_SECRET=
LANDING_LEAD_SLACK_WEBHOOK_URL=

# Kubo portal integration
KUBO_PORTAL_URL=
KUBO_DEMO_REQUEST_TOKEN=
KUBO_COST_AZURE_REGION=

# MCP portal
MCP_PORTAL_ENCRYPTION_KEY=

# Azure Communication Services — email
ACS_CONNECTION_STRING=
ACS_SENDER_EMAIL=

# Admin tenant console origin — feeds tenant seed branding (logo URLs)
CONSOLE_ORIGIN=
