{
  "tags": [
    {
      "name": "Ai chat",
      "description": "The Ask AI assistant in the admin console, and the writes it proposes."
    }
  ],
  "paths": {
    "/api/ai-chat/completions": {
      "post": {
        "summary": "Ask AI chat",
        "description": "Send the conversation to the assistant. The assistant may read this tenant with the caller's token, and may propose writes. Proposed writes are returned in `actions` and run only after the user confirms them.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["messages"],
                "properties": {
                  "messages": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 40,
                    "items": {
                      "type": "object",
                      "required": ["role", "content"],
                      "properties": {
                        "role": { "type": "string", "enum": ["user", "assistant"] },
                        "content": { "type": "string", "minLength": 1, "maxLength": 8000 }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The assistant's reply, and any writes it proposed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "content": { "type": "string" },
                    "actions": { "type": "array", "items": { "type": "object" } }
                  }
                }
              }
            }
          },
          "503": { "description": "The assistant is not configured or could not answer." }
        }
      }
    },
    "/api/ai-chat/actions": {
      "post": {
        "summary": "Propose a write",
        "description": "Store a write as a pending action. Nothing is created here. The stored body is returned for review, and the write runs only when the user confirms the action.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["tool", "arguments"],
                "properties": {
                  "tool": { "type": "string", "minLength": 1 },
                  "arguments": { "type": "object" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The pending action, with the body that will be sent on confirm.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "tool": { "type": "string" },
                    "body": { "type": "object" },
                    "expiresAt": { "type": "string", "format": "date-time" }
                  }
                }
              }
            }
          },
          "400": { "description": "The tool is not a write tool, or the arguments do not fit it." }
        }
      }
    },
    "/api/ai-chat/actions/{id}/confirm": {
      "post": {
        "summary": "Confirm a pending action",
        "description": "Run a pending action once, with the body stored when it was proposed. The caller's bearer token is used for the Management API call.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "The action ran. `result` is the Management API response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "result": { "type": "object" } }
                }
              }
            }
          },
          "400": { "description": "The action's tool is no longer available." },
          "401": { "description": "No bearer token was sent." },
          "404": { "description": "No such action for this user, or dev features are disabled." },
          "409": {
            "description": "The action was already run or cancelled, or its body was changed."
          },
          "410": { "description": "The action expired before it was confirmed." }
        }
      }
    },
    "/api/ai-chat/actions/{id}/cancel": {
      "post": {
        "summary": "Cancel a pending action",
        "description": "Cancel a proposed write that has not been confirmed yet.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "The action was cancelled." },
          "404": { "description": "No pending action with this id for this user." }
        }
      }
    }
  }
}
