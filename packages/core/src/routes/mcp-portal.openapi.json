      "delete": {
        "summary": "Remove an upstream MCP server",
        "description": "Unlink an upstream MCP server from a portal.",
        "parameters": [
          {
            "name": "portalId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
