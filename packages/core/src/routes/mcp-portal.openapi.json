      "get": {
        "summary": "List upstream MCP servers",
        "description": "List the upstream MCP servers linked to a portal.",
        "parameters": [
          {
            "name": "portalId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request succeeded."
          },
          "400": {
            "description": "The request is invalid."
          },
          "404": {
            "description": "The resource was not found."
          }
        }
      },
      "post": {
        "summary": "Add an upstream MCP server",
        "description": "Link an upstream MCP server to a portal.",
        "parameters": [
          {
            "name": "portalId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request succeeded."
          },
          "400": {
            "description": "The request is invalid."
          },
          "404": {
            "description": "The resource was not found."
          }
        }
      }
