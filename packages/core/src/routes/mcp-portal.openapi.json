            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request succeeded."
          },
          "400": {
            "description": "The request is invalid."
          },
          "404": {
            "description": "The resource was not found."
          }
        }
      },
      "delete": {
        "summary": "Remove an upstream credential",
        "description": "Delete the stored credential for an upstream MCP server.",
        "parameters": [
          {
            "name": "portalId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request succeeded."
          },
          "400": {
            "description": "The request is invalid."
          },
          "404": {
            "description": "The resource was not found."
          }
        }
      }
    },
    "/api/mcp-portal/portals/{portalId}/upstreams/{name}/oauth/start": {
      "post": {
        "summary": "Start upstream OAuth sign-in",
        "description": "Start the OAuth sign-in that gives the portal a credential for an upstream MCP server. Returns the authorization URL.",
        "parameters": [
          {
            "name": "portalId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
