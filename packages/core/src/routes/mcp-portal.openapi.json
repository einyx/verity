      "patch": {
        "summary": "Update an upstream MCP server",
        "description": "Update the settings of an upstream MCP server linked to a portal.",
        "parameters": [
          {
            "name": "portalId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request succeeded."
          },
          "400": {
            "description": "The request is invalid."
          },
          "404": {
            "description": "The resource was not found."
          }
        }
