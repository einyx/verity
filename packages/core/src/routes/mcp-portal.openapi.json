{
  "tags": [
    {
      "name": "Mcp portal",
      "description": "MCP portals, the upstream MCP servers they expose, and their credentials."
    },
    {
      "name": "Dev feature",
      "description": "In-development MCP portal endpoints. Only served while dev features are enabled."
    }
  ],
  "paths": {
    "/mcp-home": {
      "get": {
        "tags": ["Dev feature"],
        "summary": "Read one portal's home data",
        "description": "On a portal host: the servers the caller's organizations can use, and the connect commands for the portal. Requires a bearer token from the tenant's OIDC issuer carrying the organizations scope.",
        "responses": {
          "200": {
            "description": "The request succeeded."
          },
          "401": {
            "description": "No bearer token was provided."
          },
          "403": {
            "description": "The caller's organizations are not granted to the portal."
          }
        }
      }
    },
    "/callback/exchange": {
      "post": {
        "tags": ["Dev feature"],
        "summary": "Exchange a portal home sign-in code",
        "description": "On a portal host: redeem an authorization code for the portal home page's tokens. The redirect URI is pinned to the caller's portal host.",
        "responses": {
          "200": {
            "description": "The request succeeded."
          },
          "400": {
            "description": "The code or verifier is missing, or the issuer refused the code."
          }
        }
      }
    },
    "/api/mcp-portal/portals": {
      "get": {
        "summary": "List MCP portals",
        "description": "List the MCP portals in this tenant.",
        "responses": {
          "200": {
            "description": "The request succeeded."
          },
          "400": {
            "description": "The request is invalid."
          },
          "404": {
            "description": "The resource was not found."
          }
        }
      },
      "post": {
        "summary": "Create an MCP portal",
        "description": "Create an MCP portal. When deployment-managed hosting is enabled, subdomain is optional and an address ending in -mcp is generated if omitted. Legacy hosting still requires subdomain and uses the tenant's configured base domain.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string", "minLength": 1, "maxLength": 100 },
                  "subdomain": {
                    "type": "string",
                    "description": "A single DNS label; required unless managed hosting is enabled."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The request succeeded."
          },
          "400": {
            "description": "The request is invalid."
          },
          "404": {
            "description": "The resource was not found."
          }
        }
      }
    },
    "/api/mcp-portal/settings": {
      "get": {
        "summary": "Get MCP portal settings",
        "description": "Return the MCP portal settings for this tenant. Deployment-managed hosting overrides tenant domain settings.",
        "responses": {
          "200": {
            "description": "The request succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "baseDomain": { "type": "string" },
                    "managed": { "type": "boolean", "x-logto-dev-feature": true },
                    "hostnameSuffix": { "type": "string", "x-logto-dev-feature": true }
                  }
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid."
          },
          "404": {
            "description": "The resource was not found."
          }
        }
      },
      "put": {
        "summary": "Update MCP portal settings",
        "description": "Replace the MCP portal settings for this tenant. Returns 400 when the deployment manages portal hosting.",
        "responses": {
          "200": {
            "description": "The request succeeded."
          },
          "400": {
            "description": "The request is invalid."
          },
          "404": {
            "description": "The resource was not found."
          }
        }
      }
    },
    "/api/mcp-portal/portals/{portalId}/hosting": {
      "get": {
        "tags": ["Dev feature"],
        "summary": "Check managed portal HTTPS readiness",
        "description": "Checks HTTPS discovery for a portal owned by this tenant, only under the deployment-managed domain. No redirects are followed. Ready describes hosting, not organization grants or upstream availability.",
        "parameters": [
          { "name": "portalId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Hosting status.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status"],
                  "properties": {
                    "status": { "type": "string", "enum": ["ready", "pending", "unmanaged"] }
                  }
                }
              }
            }
          },
          "400": { "description": "Invalid portal id." },
          "404": { "description": "Portal not found or managed hosting is disabled." }
        }
      }
    },
    "/api/mcp-portal/portals/{portalId}": {
      "delete": {
        "summary": "Delete an MCP portal",
        "description": "Delete an MCP portal and its upstream links.",
        "parameters": [
          {
            "name": "portalId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request succeeded."
          },
          "400": {
            "description": "The request is invalid."
          },
          "404": {
            "description": "The resource was not found."
          }
        }
      }
    },
    "/api/mcp-portal/portals/{portalId}/organizations": {
      "put": {
        "summary": "Set the organizations of an MCP portal",
        "description": "Replace the organizations that may open this MCP portal.",
        "parameters": [
          {
            "name": "portalId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request succeeded."
          },
          "400": {
            "description": "The request is invalid."
          },
          "404": {
            "description": "The resource was not found."
          }
        }
      }
    },
    "/api/mcp-portal/portals/{portalId}/upstreams": {
      "get": {
        "summary": "List upstream MCP servers",
        "description": "List the upstream MCP servers linked to a portal.",
        "parameters": [
          {
            "name": "portalId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request succeeded."
          },
          "400": {
            "description": "The request is invalid."
          },
          "404": {
            "description": "The resource was not found."
          }
        }
      },
      "post": {
        "summary": "Add an upstream MCP server",
        "description": "Link an upstream MCP server to a portal.",
        "parameters": [
          {
            "name": "portalId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request succeeded."
          },
          "400": {
            "description": "The request is invalid."
          },
          "404": {
            "description": "The resource was not found."
          }
        }
      }
    },
    "/api/mcp-portal/portals/{portalId}/upstreams/{name}/tools": {
      "get": {
        "summary": "List an upstream server's tools",
        "description": "List the tools that an upstream MCP server exposes through the portal.",
        "parameters": [
          {
            "name": "portalId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request succeeded."
          },
          "400": {
            "description": "The request is invalid."
          },
          "404": {
            "description": "The resource was not found."
          }
        }
      }
    },
    "/api/mcp-portal/portals/{portalId}/upstreams/{name}": {
      "patch": {
        "summary": "Update an upstream MCP server",
        "description": "Update the settings of an upstream MCP server linked to a portal.",
        "parameters": [
          {
            "name": "portalId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request succeeded."
          },
          "400": {
            "description": "The request is invalid."
          },
          "404": {
            "description": "The resource was not found."
          }
        }
      },
      "delete": {
        "summary": "Remove an upstream MCP server",
        "description": "Unlink an upstream MCP server from a portal.",
        "parameters": [
          {
            "name": "portalId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request succeeded."
          },
          "400": {
            "description": "The request is invalid."
          },
          "404": {
            "description": "The resource was not found."
          }
        }
      }
    },
    "/api/mcp-portal/portals/{portalId}/upstreams/{name}/credential": {
      "put": {
        "summary": "Set an upstream credential",
        "description": "Store the credential the portal uses to call an upstream MCP server. The credential is encrypted at rest.",
        "parameters": [
          {
            "name": "portalId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request succeeded."
          },
          "400": {
            "description": "The request is invalid."
          },
          "404": {
            "description": "The resource was not found."
          }
        }
      },
      "delete": {
        "summary": "Remove an upstream credential",
        "description": "Delete the stored credential for an upstream MCP server.",
        "parameters": [
          {
            "name": "portalId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request succeeded."
          },
          "400": {
            "description": "The request is invalid."
          },
          "404": {
            "description": "The resource was not found."
          }
        }
      }
    },
    "/api/mcp-portal/portals/{portalId}/upstreams/{name}/oauth/start": {
      "post": {
        "summary": "Start upstream OAuth sign-in",
        "description": "Start the OAuth sign-in that gives the portal a credential for an upstream MCP server. Returns the authorization URL.",
        "parameters": [
          {
            "name": "portalId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request succeeded."
          },
          "400": {
            "description": "The request is invalid."
          },
          "404": {
            "description": "The resource was not found."
          }
        }
      }
    },
    "/api/mcp-portal/oauth/callback": {
      "get": {
        "summary": "Complete upstream OAuth sign-in",
        "description": "The browser redirect target of the upstream OAuth sign-in. It is not called by API clients.",
        "responses": {
          "200": {
            "description": "The request succeeded."
          },
          "400": {
            "description": "The request is invalid."
          },
          "404": {
            "description": "The resource was not found."
          }
        }
      }
    }
  }
}
